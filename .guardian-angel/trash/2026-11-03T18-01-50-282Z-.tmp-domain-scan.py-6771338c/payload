import os, re

roots = ['skills', os.path.expanduser('~/.config/opencode/skills')]
seen = {}
for root in roots:
    if not os.path.isdir(root):
        continue
    for name in sorted(os.listdir(root)):
        p = os.path.join(root, name, 'SKILL.md')
        if name in seen or not os.path.isfile(p):
            continue
        raw = open(p, encoding='utf-8', errors='replace').read()
        m = re.match(r'^---\s*\n(.*?)\n---', raw, re.S)
        desc = ''
        if m:
            dm = re.search(r'^description:\s*(.+)$', m.group(1), re.M)
            if dm:
                desc = dm.group(1).strip().strip('"').strip("'")
        seen[name] = desc

print('total skills indexed:', len(seen))


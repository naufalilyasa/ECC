    'energy/utilities': ['energy', 'utility', 'tariff', 'ppa', 'electricity'],
    'agriculture': ['agriculture', 'farm', 'crop', 'yield'],
    'retail/ecommerce': ['retail', 'ecommerce', 'e-commerce', 'merchandis', 'basket'],

    'manufacturing/ops': ['manufacturing', 'production', 'oee', 'quality', 'scheduling'],
    'customer-success/support': ['customer success', 'churn', 'nps', 'ticket', 'helpdesk'],
    'product/ux-metrics': ['retention', 'engagement', 'activation', 'cohort', 'experiment'],

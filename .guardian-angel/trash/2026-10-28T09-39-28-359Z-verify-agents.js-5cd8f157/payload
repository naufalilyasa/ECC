const cp = require('child_process');
const out = cp.execSync('opencode debug agents', { maxBuffer: 10 * 1024 * 1024 }).toString();
const agents = JSON.parse(out);
const targets = ['explore', 'architect', 'librarian', 'plan-reviewer', 'code-reviewer'];
for (const a of agents) {
  if (targets.includes(a.id)) {
    console.log('=== AGENT:', a.id, '===');
    console.log('model:', a.model);
    console.log('description:', a.description);
    console.log('system (first 180 chars):', JSON.stringify((a.system || '').slice(0, 180)));
  }
}
